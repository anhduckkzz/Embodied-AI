# IDE / caches
/.idea
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Python build / packaging artifacts (generated by `pip install -e .`)
*.egg-info/
build/
dist/

# Training artifacts (keep the repo light; models are reproducible)
/runs/
*.pt
# Allow the original committed checkpoint used by legacy/ + docs
!model/checkpoint.pth

# Generated media (regenerate with scripts/record.py)
/video/*.mp4
/video/*.meta.json

# Generated demo plots (each curriculum *_demo.py / build_*.py regenerates its own PNG)
curriculum/**/*_demo.png
curriculum/**/build_*.png
